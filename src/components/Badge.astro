---
interface Props {
  tone?: 'illustrative' | 'draft' | 'accent' | 'neutral';
}
const { tone = 'neutral' } = Astro.props;
---

<span class={`badge badge--${tone}`}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.65rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--c-line);
    background: var(--c-surface-2);
    color: var(--c-text);
    line-height: 1.4;
  }
  .badge--illustrative {
    padding: 0;
    border: 0;
    background: none;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: rgb(237 242 247 / 0.72);
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.7);
    pointer-events: none;
  }
  .badge--draft {
    background: #3a2d05;
    border-color: var(--c-warning);
    color: #ffe6a3;
  }
  .badge--accent {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-on-accent);
  }
</style>
