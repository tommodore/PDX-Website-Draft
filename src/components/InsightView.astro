---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import Section from './Section.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Badge from './Badge.astro';
import CtaBand from './CtaBand.astro';
import { navTitle } from '../lib/content';
import { pathOf, ancestorsOf, absoluteUrl, type Lang } from '../lib/routes';
import { detailPath } from '../lib/paths';
import { t } from '../i18n/ui';

interface Props {
  slug: string;
  lang: Lang;
}
const { slug, lang } = Astro.props;
const ui = t(lang);
const entry = await getEntry('insights', `${lang}/${slug}`);
if (!entry) throw new Error(`Missing insight ${lang}/${slug}`);
const d = entry.data;
const { Content } = await render(entry);
const parent = 'insights';
const path = detailPath(parent, slug, lang);
const crumbs = [
  ...(await Promise.all([...ancestorsOf(parent).map((n) => n.id), parent].map(async (n) => ({ label: await navTitle(n, lang), href: pathOf(n, lang) })))),
  { label: d.title, href: path },
];
const alternates = { en: detailPath(parent, slug, 'en'), de: detailPath(parent, slug, 'de') };
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString().slice(0, 10),
  author: { '@type': 'Organization', name: d.author },
  publisher: { '@id': absoluteUrl('/#organization') },
  mainEntityOfPage: absoluteUrl(path),
  inLanguage: lang === 'de' ? 'de-DE' : 'en-US',
};
---

<BaseLayout title={d.title} description={d.description} lang={lang} path={path} alternates={alternates} currentId={parent} noindex={d.draft} crumbs={crumbs} jsonLd={[ld]} type="article">
  <Hero lang={lang} image={d.illustration} eyebrow={d.type}>
    <Breadcrumbs slot="crumbs" items={crumbs} lang={lang} />
    <h1>{d.title}</h1>
    <p class="lead">{d.description}</p>
    <div class="cluster">
      {d.draft && <Badge tone="draft">{ui.draft}</Badge>}
      <time datetime={d.date.toISOString().slice(0, 10)} class="muted">{d.date.toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-US', { dateStyle: 'long' })}</time>
    </div>
  </Hero>
  <Section>
    <div class="prose stack"><Content /></div>
  </Section>
  <CtaBand lang={lang} />
</BaseLayout>
