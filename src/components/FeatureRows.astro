---
import Media from './Media.astro';
import Badge from './Badge.astro';
import { t } from '../i18n/ui';
import type { Lang } from '../lib/routes';

interface Item {
  title: string;
  text: string;
  image?: string;
  video?: string;
  alt?: string;
}
interface Props {
  items: Item[];
  lang: Lang;
}
const { items, lang } = Astro.props;
const ui = t(lang);
---

<div class="rows">
  {
    items.map((it, i) => (
      <article class:list={['row', 'reveal', { 'row--flip': i % 2 === 1 }]}>
        <div class="row__text">
          <span class="row__index">{String(i + 1).padStart(2, '0')}</span>
          <h3>{it.title}</h3>
          <p class="muted">{it.text}</p>
        </div>
        <div class="row__media">
          {it.video ? (
            <figure class="row__frame">
              <video muted loop playsinline preload="none" poster={`/media/${it.video}.webp`} aria-label={`${it.alt ?? it.title}. ${ui.illustrative}`} data-row-video>
                <source src={`/media/${it.video}.mp4`} type="video/mp4" />
              </video>
              <span class="row__badge"><Badge tone="illustrative">{ui.illustrative}</Badge></span>
            </figure>
          ) : it.image ? (
            <Media name={it.image} alt={it.alt ?? it.title} lang={lang} ratio="4 / 3" sizes="(min-width: 60rem) 50vw, 100vw" class="row__frame" />
          ) : null}
        </div>
      </article>
    ))
  }
</div>

<script>
  const vids = document.querySelectorAll<HTMLVideoElement>('[data-row-video]');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    vids.forEach((v) => (v.controls = true));
  } else {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }),
      { threshold: 0.4 }
    );
    vids.forEach((v) => io.observe(v));
  }
</script>

<style>
  .rows {
    display: grid;
    gap: var(--sp-8);
    margin-top: var(--sp-8);
  }
  .row {
    display: grid;
    gap: var(--sp-5);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .row {
      grid-template-columns: 5fr 7fr;
      gap: var(--sp-8);
    }
    .row--flip .row__text {
      order: 2;
    }
  }
  .row__index {
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: var(--c-accent);
  }
  .row__text h3 {
    margin: var(--sp-2) 0 var(--sp-3);
  }
  .row__text p {
    max-width: 34rem;
  }
  .row__frame {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--r-lg);
    aspect-ratio: 4 / 3;
    background: var(--c-surface-1);
    box-shadow: var(--shadow-glow, 0 20px 60px rgb(0 0 0 / 0.4));
  }
  .row__frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .row__badge {
    position: absolute;
    right: var(--sp-3);
    bottom: var(--sp-3);
  }
</style>
