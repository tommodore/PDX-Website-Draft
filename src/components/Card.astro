---
import Media from './Media.astro';
import Badge from './Badge.astro';
import type { Lang } from '../lib/routes';

interface Props {
  title: string;
  text?: string;
  href?: string;
  image?: string;
  lang?: Lang;
  badge?: string;
  cta?: string;
}
const { title, text, href, image, lang = 'en', badge, cta } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="card reveal" href={href}>
  {image && <Media name={image} lang={lang} ratio="16 / 9" class="card__media" sizes="(min-width: 56rem) 360px, 100vw" />}
  <div class="card__body">
    {badge && <Badge tone="draft">{badge}</Badge>}
    <h3>{title}</h3>
    {text && <p class="muted">{text}</p>}
    {cta && <span class="card__cta">{cta} <span aria-hidden="true">&rarr;</span></span>}
  </div>
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--c-surface-1);
    border: 1px solid var(--c-line-soft);
    border-radius: var(--r-lg);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-cine),
      box-shadow var(--dur-slow) var(--ease-cine);
  }
  a.card:hover {
    transform: translateY(-4px);
    border-color: var(--c-primary);
    box-shadow: var(--glow-primary);
    color: inherit;
  }
  .card :global(.card__media) {
    border-radius: 0;
  }
  .card__body {
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    flex: 1;
  }
  .card h3 {
    font-size: var(--fs-lg);
    margin: var(--sp-2) 0 0;
  }
  .card p {
    margin: 0;
    font-size: var(--fs-sm);
  }
  .card__cta {
    margin-top: auto;
    padding-top: var(--sp-3);
    color: var(--c-primary);
    font-weight: 600;
    font-size: var(--fs-sm);
  }
</style>
