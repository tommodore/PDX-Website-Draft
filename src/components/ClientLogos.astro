---
import { existsSync, readFileSync } from 'node:fs';
import { clients } from '../data/clients';
import type { Lang } from '../lib/routes';

interface Props {
  lang: Lang;
  group?: 'client' | 'tech';
  caption?: boolean;
}
const { lang, group = 'client', caption = true } = Astro.props;
const de = lang === 'de';
const label = group === 'tech' ? (de ? 'Engines und Toolkits, mit denen wir bauen' : 'Engines and toolkits we build with') : de ? 'Marken, für die wir arbeiten' : 'Brands we work with';
const note = de ? 'Alle Marken und Logos sind Eigentum ihrer jeweiligen Inhaber.' : 'All brands and logos are the property of their respective owners.';

function logoOf(slug: string) {
  for (const ext of ['svg', 'png']) {
    const file = `public/brand/clients/${slug}.${ext}`;
    if (!existsSync(file)) continue;
    const src = `/brand/clients/${slug}.${ext}`;
    if (ext === 'svg') return { src };
    const head = readFileSync(file).subarray(16, 24);
    return { src, width: head.readUInt32BE(0), height: head.readUInt32BE(4) };
  }
  return undefined;
}
const items = clients.filter((c) => c.show && c.group === group).map((c) => ({ ...c, logo: logoOf(c.slug) }));
---

<figure class={`clients clients--${group}`}>
  <p class="clients__label">{label}</p>
  <ul aria-label={label}>
    {
      items.map((c) => {
        const mark = c.logo ? <img src={c.logo.src} alt={c.name} width={c.logo.width} height={c.logo.height} loading="lazy" decoding="async" /> : <span>{c.name}</span>;
        return <li>{c.url ? <a href={c.url} target="_blank" rel="noopener">{mark}</a> : mark}</li>;
      })
    }
  </ul>
  {caption && <figcaption class="muted">{note}</figcaption>}
</figure>

<style>
  .clients {
    margin: 0;
    text-align: center;
  }
  .clients__label {
    margin: 0 0 var(--sp-5);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--c-text-muted);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3) var(--sp-4);
  }
  li {
    margin: 0;
    width: 8.5rem;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.8;
    transition: opacity var(--dur-2, 0.2s) ease;
  }
  li:hover {
    opacity: 1;
  }
  li a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: var(--r-md);
  }
  span {
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }
  img {
    width: auto;
    height: auto;
    max-width: 7.5rem;
    max-height: 3rem;
    object-fit: contain;
  }
  .clients--tech li {
    width: 7rem;
    height: 3rem;
    opacity: 0.6;
  }
  .clients--tech li:hover {
    opacity: 1;
  }
  .clients--tech img {
    max-width: 5.5rem;
    max-height: 2rem;
  }
  figcaption {
    margin-top: var(--sp-5);
    font-size: 0.75rem;
  }
  @media (max-width: 30rem) {
    ul {
      gap: var(--sp-2) var(--sp-3);
    }
    li {
      width: 6rem;
      height: 3.25rem;
    }
    img {
      max-width: 5rem;
      max-height: 2.5rem;
    }
    .clients--tech li {
      width: 5.5rem;
    }
  }
</style>
