---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/Badge.astro';

const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255);
const lin = (c: number) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
const lum = (h: string) => {
  const [r, g, b] = hex(h).map(lin);
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const ratio = (a: string, b: string) => {
  const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p);
  return (x + 0.05) / (y + 0.05);
};

const surfaces = [
  ['--c-bg', '#010d16'],
  ['--c-surface-1', '#011826'],
  ['--c-surface-2', '#07243a'],
  ['--c-surface-3', '#0d3250'],
];
const brand = [
  ['--c-primary', '#548cff'],
  ['--c-primary-hover', '#7aa5ff'],
  ['--c-primary-strong', '#364c94'],
  ['--c-accent', '#bfd92e'],
  ['--c-success', '#5fd39a'],
  ['--c-warning', '#f2c14e'],
  ['--c-danger', '#ff7a7a'],
  ['--c-focus', '#ffd166'],
];
const pairs = [
  ['Text on background', '#edf2f7', '#010d16'],
  ['Muted text on background', '#a9bccf', '#010d16'],
  ['Faint text on background', '#7f97ae', '#010d16'],
  ['Muted text on surface 2', '#a9bccf', '#07243a'],
  ['Primary on background', '#548cff', '#010d16'],
  ['Accent on background', '#bfd92e', '#010d16'],
  ['On-primary on primary (buttons)', '#011826', '#548cff'],
  ['On-accent on accent', '#011826', '#bfd92e'],
  ['Focus ring on background', '#ffd166', '#010d16'],
].map(([name, fg, bg]) => ({ name, fg, bg, r: ratio(fg, bg) }));
const type = ['3xl', '2xl', 'xl', 'lg', 'md', 'sm', 'xs'];
const space = [1, 2, 3, 4, 5, 6, 7, 8, 9];
---

<BaseLayout title="Design system" description="PARADOX CAT design tokens, components and usage rules." lang="en" path="/design-system/" alternates={{ en: '/design-system/', de: '/de/' }} currentId="design-system" noindex>
  <main id="main" class="wrap ds">
    <p class="eyebrow">Design system</p>
    <h1>Tokens, components, rules</h1>
    <p class="lead">Dark theme only. Values come from the existing PARADOX CAT identity. Source of truth: <code>src/styles/tokens.css</code>.</p>

    <h2>Color</h2>
    <div class="swatches">
      {[...surfaces, ...brand].map(([n, v]) => (
        <div class="sw"><span class="chip" style={`background:${v}`}></span><code>{n}</code><small>{v}</small></div>
      ))}
    </div>

    <h2>Contrast (WCAG 2.2)</h2>
    <p>AA needs 4.5:1 for body text and 3:1 for large text and UI components.</p>
    <table>
      <thead><tr><th>Pair</th><th>Sample</th><th>Ratio</th><th>AA text</th></tr></thead>
      <tbody>
        {pairs.map((p) => (
          <tr><td>{p.name}</td><td><span class="sample" style={`color:${p.fg};background:${p.bg}`}>Aa</span></td><td>{p.r.toFixed(2)}:1</td><td>{p.r >= 4.5 ? 'Pass' : p.r >= 3 ? 'Large only' : 'Fail'}</td></tr>
        ))}
      </tbody>
    </table>

    <h2>Typography</h2>
    {type.map((s) => <p style={`font-size:var(--fs-${s});line-height:var(--lh-snug);margin:0 0 .5rem`}>--fs-{s}: We build emotions, not just features.</p>)}

    <h2>Spacing</h2>
    {space.map((s) => <div class="bar" style={`width:var(--sp-${s})`}><code>--sp-{s}</code></div>)}

    <h2>Buttons and badges</h2>
    <p>
      <a class="btn btn--primary" href="#main">Primary action</a>
      <a class="btn" href="#main">Secondary</a>
    </p>
    <p><Badge>Neutral</Badge> <Badge tone="illustrative">Illustrative</Badge> <Badge tone="draft">Draft</Badge> <Badge tone="accent">Accent</Badge></p>

    <h2>Components</h2>
    <p>Header with mega menu and mobile drawer, Footer, Hero, Section, Card, CaseCard, Stat, LogoWall, CtaBand, ContactForm, Tabs, Accordion, Badge, Breadcrumbs, LangSwitch, Media, Gate. All live in <code>src/components/</code>. Pages using them: Home, Ramses3D, the sample case study.</p>

    <h2>Usage rules</h2>
    <div class="dd">
      <div><h3>Do</h3><ul>
        <li>Let the work be the hero. Use full-bleed imagery and negative space.</li>
        <li>One primary action per page.</li>
        <li>Use the white logo on dark with clear space. Keep the 1.85:1 ratio.</li>
        <li>Mark generated images with the Illustrative badge.</li>
      </ul></div>
      <div><h3>Don't</h3><ul>
        <li>Do not stretch, recolor or place the logo on busy imagery without an overlay.</li>
        <li>Do not use hard cuts, spinners or modal clutter.</li>
        <li>Do not use accent lime for body text on light surfaces.</li>
        <li>Do not add third-party trackers or cookies.</li>
      </ul></div>
    </div>

    <h2>Motion</h2>
    <p>Slow, eased, camera-like. Durations and easings are tokens. All animation is disabled under <code>prefers-reduced-motion</code>.</p>

    <h2>Accessibility notes</h2>
    <ul>
      <li>Visible focus ring (<code>--c-focus</code>) on every interactive element. Skip link on every page.</li>
      <li>Mega menu works with hover, focus and keyboard. Mobile drawer is keyboard operable.</li>
      <li>Images carry alt text. Generated images say "illustrative".</li>
      <li>Language is set per page, with hreflang alternates.</li>
    </ul>
  </main>
</BaseLayout>

<style>
  .ds h2 { margin-top: var(--sp-8); }
  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: var(--sp-4); }
  .sw { display: grid; gap: 0.25rem; }
  .chip { height: 3.5rem; border-radius: var(--r-md); border: 1px solid var(--c-line); }
  .sw small { color: var(--c-text-muted); }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--c-line); }
  .sample { display: inline-block; padding: 0.1rem 0.9rem; border-radius: var(--r-sm); border: 1px solid var(--c-line); font-weight: 700; }
  .bar { height: 1.5rem; background: var(--c-primary); margin-bottom: 0.4rem; position: relative; min-width: 0.25rem; }
  .bar code { position: absolute; left: calc(100% + 0.75rem); top: 0; white-space: nowrap; }
  .dd { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: var(--sp-6); }
</style>
