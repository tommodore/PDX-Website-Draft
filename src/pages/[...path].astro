---
import HomeView from '../components/HomeView.astro';
import PageView from '../components/PageView.astro';
import CaseView from '../components/CaseView.astro';
import InsightView from '../components/InsightView.astro';
import { buildPaths, type RouteProps } from '../lib/paths';

export async function getStaticPaths() {
  return buildPaths('en');
}
const { kind, id, slug } = Astro.props as RouteProps;
---

{kind === 'case' ? <CaseView slug={slug!} lang="en" /> : kind === 'insight' ? <InsightView slug={slug!} lang="en" /> : id === 'home' ? <HomeView lang="en" /> : <PageView id={id} lang="en" />}
