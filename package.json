{
  "name": "pdx-website",
  "version": "1.0.0",
  "description": "PARADOX CAT company website (Astro, static)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "illustrations": "node scripts/generate-illustrations.mjs",
    "test:links": "linkinator http://localhost:4321/ --recurse --skip \"^(?!http://localhost:4321)\"",
    "test:a11y": "pa11y-ci --config .pa11yci.json",
    "test:lhci": "lhci autorun --config=lighthouserc.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tommodore/PDX-Website-Draft.git"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "linkinator": "^8.1.0",
    "pa11y-ci": "^5.0.0",
    "potrace": "^2.1.8",
    "staticrypt": "^3.5.4",
    "wait-on": "^9.5.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
